# Server secrets for the Gaao edge function. Real values never go in git.
#
# Production: set them in the Supabase dashboard (Project -> Edge Functions -> Secrets),
#   or with `npx supabase secrets set --env-file <file>`.
# Local `npx supabase functions serve gaao`: copy this file to supabase/functions/.env and fill it in.

# Song recognition for Listen (https://dashboard.audd.io). Leave empty to switch Listen off.
AUDD_API_TOKEN=

# Claude meanings (https://console.anthropic.com). Leave empty to switch shared meanings off.
ANTHROPIC_API_KEY=

# Optional: which Claude model explains songs.
GAAO_MODEL=claude-haiku-5-5
